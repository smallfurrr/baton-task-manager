# Database
POSTGRES_USER=baton
POSTGRES_PASSWORD=baton_dev_password
POSTGRES_DB=baton

# Server
PORT=3000
# Must match the POSTGRES_* values above. Host is `localhost` when running
# the server on your machine; Docker Compose overrides it with `db`.
DATABASE_URL=postgres://baton:baton_dev_password@localhost:5432/baton

# LLM
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
